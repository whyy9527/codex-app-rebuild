    "bfd": {
      "source": "def pack(weights, capacity):\n    bins = []\n    loads = []\n    for index in sorted(range(len(weights)), key=lambda i: -weights[i]):\n        feasible = [p for p in range(len(loads)) if loads[p] + weights[index] <= capacity]\n        if feasible:\n            position = min(feasible, key=lambda p: capacity - loads[p] - weights[index])\n            bins[position].append(index)\n            loads[position] += weights[index]\n        else:\n            bins.append([index])\n            loads.append(weights[index])\n    return bins\n",
      "source_digest": "c803765e70059112d88c219c1ada7f1a1deec8bbe90161523e2d1e86d21928f4",
