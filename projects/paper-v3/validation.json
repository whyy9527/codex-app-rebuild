    "hybrid": {
      "source": "def exact_pack(weights, capacity):\n    count = len(weights)\n    if count == 0:\n        return []\n    states = 1 << count\n    best = [(count + 1, capacity + 1)] * states\n    choices = [None] * states\n    best[0] = (1, 0)\n    for mask in range(1, states):\n        for index in range(count):\n            bit = 1 << index\n            if mask & bit:\n                previous = mask ^ bit\n                bins, load = best[previous]\n                new_bin = load + weights[index] > capacity\n                candidate = (bins + 1, weights[index]) if new_bin else (bins, load + weights[index])\n                if candidate < best[mask]:\n                    best[mask] = candidate\n                    choices[mask] = (index, new_bin)\n    actions = []\n    mask = states - 1\n    while mask:\n        index, new_bin = choices[mask]\n        actions.append((index, new_bin))\n        mask ^= 1 << index\n    bins = [[]]\n    for index, new_bin in reversed(actions):\n        if new_bin and bins[-1]:\n            bins.append([])\n        bins[-1].append(index)\n    return bins\ndef greedy_pack(weights, capacity):\n    bins = []\n    loads = []\n    order = sorted(range(len(weights)), key=lambda i: -weights[i])\n    for index in order:\n        placed = False\n        for position in range(len(bins)):\n            if loads[position] + weights[index] <= capacity:\n                bins[position].append(index)\n                loads[position] += weights[index]\n                placed = True\n                break\n        if not placed:\n            bins.append([index])\n            loads.append(weights[index])\n    return bins\ndef pack(weights, capacity):\n    greedy = greedy_pack(weights, capacity)\n    lower = (sum(weights) + capacity - 1) // capacity\n    if len(greedy) == lower:\n        return greedy\n    return exact_pack(weights, capacity)\n",
      "source_digest": "8875a011cdf7e65b169fd9623af70af6e0481fd15e9ab25f1ae3b21f07601e89",
