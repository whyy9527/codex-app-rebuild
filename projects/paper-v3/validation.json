  "programs": {
    "ffd": {
      "source": "def pack(weights, capacity):\n    bins = []\n    loads = []\n    order = sorted(range(len(weights)), key=lambda i: -weights[i])\n    for index in order:\n        placed = False\n        for position in range(len(bins)):\n            if loads[position] + weights[index] <= capacity:\n                bins[position].append(index)\n                loads[position] += weights[index]\n                placed = True\n                break\n        if not placed:\n            bins.append([index])\n            loads.append(weights[index])\n    return bins\n",
      "source_digest": "30020457dcba73140c9ca87f69d7a0393aaba0f5d8d2178caeec8837a93a89e9",
