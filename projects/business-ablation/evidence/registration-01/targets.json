        "worker/projects/duolingo-web/build-native.py",
        "worker/projects/duolingo-web/native-adapter-v3.swift",
        "worker/projects/education-swift/Package.swift",
        "worker/projects/education-swift/Tests",
        "controller.py",
        "experiment-runtime.py"
      ]
    }
  }
}
