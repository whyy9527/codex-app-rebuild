{
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ]
    },
    "@xiaogj/api#generate": {
      "cache": false,
      "outputs": [
        "src/generated/**"
      ]
    },
    "@xiaogj/api#build": {
      "dependsOn": [
        "^build",
        "@xiaogj/api#generate"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@xiaogj/api#typecheck": {
      "dependsOn": [
        "^build",
        "@xiaogj/api#generate"
      ]
    },
    "@xiaogj/api#dev": {
      "dependsOn": [
        "^build",
        "@xiaogj/api#generate"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
