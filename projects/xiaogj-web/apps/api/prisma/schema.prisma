generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

model AuthUser {
  id String @id @db.VarChar(80)
  username String @unique @db.VarChar(200)
  displayName String @db.VarChar(200)
  passwordHash String @db.VarChar(100)
  active Boolean @default(true)
  sessions AuthSession[]
}

model AuthSession {
  id String @id @db.VarChar(80)
  userId String @db.VarChar(80)
  expiresAt DateTime
  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model StudentCapture {
  id       String @id @db.VarChar(80)
  total    Int
  page     Int
  pageSize Int
  pages    Int
  students Student[]
}

model Student {
  id          String @id @db.VarChar(80)
  name        String @db.VarChar(200)
  nameInitials String @default("") @db.VarChar(200)
  account     String @db.VarChar(200)
  number      String @db.VarChar(80)
  identity    String @db.VarChar(80)
  phone       String @db.VarChar(80)
  englishName String @db.VarChar(200)
  card        String @db.VarChar(80)
  school      String @db.VarChar(200)
  status      String @db.VarChar(80)
  gender      String @db.VarChar(20)
  position    Int
  captureId   String @db.VarChar(80)
  capture     StudentCapture @relation(fields: [captureId], references: [id], onDelete: Cascade)
  detail      StudentDetail?
  @@index([captureId, position])
}

model StudentDetail {
  studentId String @id @db.VarChar(80)
  data Json
  observedAt DateTime
  provenance String @db.VarChar(500)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}
