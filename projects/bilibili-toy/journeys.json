{
  "schema_version": 1,
  "source": "Original native observations in private/player-source-20261015 and private/source-host-20261015; first-bp.ax.txt actually shows full post-game data, not BP.",
  "cases": [
    {
      "id": "player",
      "steps": [
        {
          "action": "click",
          "match": "\\d+ link 首页, Value:"
        },
        {
          "action": "click",
          "match": "\\d+ link Claude Opus 5\\.5, Value:"
        },
        {
          "action": "click_if_present",
          "match": "\\d+ button  暂停, Help:"
        },
        {
          "action": "click_if_present",
          "match": "\\d+ checkbox 闲置 60 秒后自动换台, Value: 1"
        },
        {
          "action": "click",
          "match": "\\d+ button 赛前$"
        },
        {
          "action": "click",
          "match": "\\d+ button 1x$",
          "capture": "player-preseason"
        },
        {
          "action": "click",
          "match": "\\d+ button 下一步,",
          "capture": "player-first-series"
        },
        {
          "action": "click",
          "match": "\\d+ button 下一步,",
          "capture": "player-first-game-data"
        },
        {
          "action": "click",
          "match": "\\d+ toggle button BP,",
          "capture": "player-bp"
        },
        {
          "action": "click",
          "match": "\\d+ toggle button 比赛,",
          "capture": "player-match"
        },
        {
          "action": "click",
          "match": "\\d+ toggle button 结果,",
          "capture": "player-result"
        },
        {
          "action": "click",
          "match": "\\d+ toggle button 数据,",
          "capture": "player-data"
        },
        {
          "action": "click",
          "match": "\\d+ button 上一步,",
          "capture": "player-previous-series"
        },
        {
          "action": "click",
          "match": "\\d+ button 下一天,",
          "capture": "player-next-day"
        },
        {
          "action": "click",
          "match": "\\d+ button 下一场,",
          "capture": "player-next-series"
        }
      ]
    },
    {
      "id": "host",
      "steps": [
        {
          "action": "click",
          "match": "\\d+ link AI 赛制介绍, Value:"
        },
        {
          "action": "click",
          "match": "\\d+ button 展开详情$",
          "capture": "host-expanded"
        },
        {
          "action": "click",
          "match": "\\d+ button 相关$",
          "capture": "host-related"
        },
        {
          "action": "click",
          "match": "\\d+ button 收起$",
          "capture": "host-collapsed"
        }
      ]
    },
    {
      "id": "entry",
      "steps": [
        {
          "action": "goto_query",
          "query": "?p=pickem",
          "ready": "heading 我来预测, Value: 1",
          "capture": "entry-pickem"
        }
      ]
    }
  ]
}
