{
  "schema_version": 1,
  "source": "Source observations private/predict-source-2; Safari successfully activated official draw. Current protocol preserves existing drafts by requiring an empty prestate.",
  "cases": [
    {
      "id": "playin",
      "steps": [
        {
          "action": "capture",
          "capture": "prediction-empty"
        },
        {
          "action": "click",
          "match": "\\d+ button 揭晓对阵$",
          "capture": "prediction-draw"
        },
        {
          "action": "click",
          "match": "\\d+ toggle button C9 41% 0, Value: (?:off|0)$",
          "capture": "prediction-c9"
        },
        {
          "action": "click",
          "match": "\\d+ toggle button KC 59% 8, Value: (?:off|0)$",
          "capture": "prediction-changed-kc"
        },
        {
          "action": "click",
          "match": "\\d+ toggle button FUR 79% 8, Value: (?:off|0)$",
          "capture": "prediction-two-winners"
        },
        {
          "action": "click",
          "match": "\\d+ toggle button KC 76% 8, Value: (?:off|0)$",
          "capture": "prediction-upper-final"
        },
        {
          "action": "click",
          "match": "\\d+ toggle button C9 90% 8, Value: (?:off|0)$",
          "capture": "prediction-four-winners"
        },
        {
          "action": "click",
          "match": "\\d+ toggle button FUR 32% 2, Value: (?:off|0)$",
          "capture": "prediction-lower-final"
        },
        {
          "action": "click",
          "match": "\\d+ toggle button KC 76% 8, Value: (?:off|0)$",
          "capture": "prediction-complete"
        },
        {
          "action": "reload",
          "capture": "prediction-reloaded"
        }
      ]
    },
    {
      "id": "share",
      "query": "?p=pickem&pick=GEN.AL.DK.G2.T1.HLE.BLG.LYON_HLE.T1.GEN.BLG_GEN",
      "source": "Actual UI-copied original prediction report; private/result-source-safari-1/copied-report-address.ax.txt. Both endpoints must have no selected PI winners or locked result.",
      "steps": [
        {
          "action": "scroll_top",
          "capture": "share-imported"
        },
        {
          "action": "click",
          "match": "\\d+ button 收起$",
          "capture": "share-collapsed"
        },
        {
          "action": "reload",
          "capture": "share-reloaded"
        }
      ]
    },
    {
      "id": "locked",
      "source": "Already locked test prediction from the observed anonymous autofill/lock UI. Random brackets stay distinct; this case compares champion, choice counts, copy feedback and retention of each endpoint actual timestamp and choices.",
      "steps": [
        {
          "action": "capture",
          "capture": "final-locked"
        },
        {
          "action": "reload",
          "capture": "final-reloaded"
        },
        {
          "action": "click",
          "match": "\\d+ button 重新预测$",
          "capture": "final-reset-attempt"
        },
        {
          "action": "click",
          "match": "\\d+ button 复制预测战报$",
          "capture": "final-copied"
        }
      ]
    }
  ]
}
